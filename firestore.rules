rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: own profile read/write; any verified user can read others (for search/invite display)
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Group invite inbox — only the invitee can read/delete; invite senders write via service
      match /groupInvites/{groupId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null; // group owner writes here
      }
    }

    // Games: any authenticated user (including anonymous) can create games
    // Anyone authenticated can read games
    // Only the creator can write (update/delete)
    match /games/{gameId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
                       (request.auth.uid == resource.data.createdBy ||
                        resource.data.players.size() > 0);
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      // Rounds: any player in the game can add/read rounds
      match /rounds/{roundId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }
    }

    // Scan feedback for AI training — any authenticated user can write, only owner can read
    match /scanFeedback/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Groups: any member can read; only owner can update membership/name;
    // verified users can create groups
    match /groups/{groupId} {
      allow read:   if request.auth != null &&
                       (resource.data.ownerUid == request.auth.uid ||
                        request.auth.uid in resource.data.memberUids ||
                        request.auth.uid in resource.data.pendingInviteUids);
      allow create: if request.auth != null && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
      allow update: if request.auth != null &&
                       (resource.data.ownerUid == request.auth.uid ||
                        // allow accepting/declining invites (member adds self)
                        request.auth.uid in resource.data.pendingInviteUids);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
