rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────────
    // Any signed-in user can read any profile (needed for name search + invite display).
    // Only the owner can write their own profile.
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Group invite inbox lives as a sub-collection on the user doc.
    // The invitee can read/delete their own invites.
    // Any signed-in user can create/update (so group owners can send invites).
    match /users/{uid}/groupInvites/{groupId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null;
    }

    // ── Games ─────────────────────────────────────────────────────────────────
    match /games/{gameId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
                       (request.auth.uid == resource.data.createdBy ||
                        resource.data.players.size() > 0);
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /rounds/{roundId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }
    }

    // ── Scan feedback ─────────────────────────────────────────────────────────
    match /scanFeedback/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ── Groups ────────────────────────────────────────────────────────────────
    // Any authenticated non-anonymous user can create a group.
    // Read: allowed for any signed-in user — the query already filters by memberUids
    //       so only the user's own groups come back. Keeping this open avoids the
    //       per-document resource.data check that can break collection queries.
    // Update: owner can do anything; pending invitees can accept/decline (add/remove self).
    match /groups/{groupId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.token.firebase.identities.keys().hasAny(['google.com']);
      allow update: if request.auth != null &&
                       (resource.data.ownerUid == request.auth.uid ||
                        request.auth.uid in resource.data.pendingInviteUids);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
